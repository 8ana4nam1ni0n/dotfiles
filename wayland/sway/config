# -----------------------------------------------------------
# Gaps
# -----------------------------------------------------------
default_border pixel 0
gaps outer 15
gaps inner 10

# -----------------------------------------------------------
# Theme
# -----------------------------------------------------------

# set primary Rosé Pine colorscheme colors
set $base           #191724
set $surface        #1f1d2e
set $overlay        #26233a
set $muted          #6e6a86
set $subtle         #908caa
set $text           #e0def4
set $love           #eb6f92
set $gold           #f6c177
set $rose           #ebbcba
set $pine           #31748f
set $foam           #9ccfd8
set $iris           #c4a7e7
set $highlightlow   #21202e
set $highlightmed   #403d52
set $highlighthigh  #524f67

# Teming border and Windows --------------
# target                 title     bg    text   indicator  border
client.focused           $rose     $base $text  $rose      $rose
client.focused_inactive  $text     $base $text  $subtle    $surface
client.unfocused         $text     $base $text  $overlay   $overlay
client.urgent            $text     $base $text  $love      $love
client.placeholder       $base     $base $text  $overlay   $overlay
client.background        $base

# -----------------------------------------------------------
# Program Windows Configuration
# -----------------------------------------------------------

# app windows float config
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable

# --------------------------------------------------------
# Portal Configuration & Startup Fixes (Use /usr/libexec/ paths)
# --------------------------------------------------------

# Ensure D-Bus environment variables are updated for systemd services
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# Kill any lingering portal processes to prevent conflicts on restart
exec killall xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk

# Wait briefly for stability
exec sleep 1

# Manually start the backends and the main portal service in order

# Start the WLR backend
exec --no-startup-id /usr/libexec/xdg-desktop-portal-wlr &

# Start the GTK backend
exec --no-startup-id /usr/libexec/xdg-desktop-portal-gtk &

# Start the main portal service. This should now succeed.
exec --no-startup-id /usr/libexec/xdg-desktop-portal &

# -----------------------------------------------------------
# Notifications
# -----------------------------------------------------------
exec swaync
