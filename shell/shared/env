#!/bin/sh

export XDG_CONFIG_HOME=$HOME/.config
export TOOL_PATH=$HOME/Tools

################################################################################
# nvm - Node Version Manager
################################################################################
[ -d "$XDG_CONFIG_HOME/nvm" ] \
    && export NVM_DIR="$HOME/.config/nvm" \
    || [ -d "$HOME/.nvm" ] && export NVM_DIR="$HOME/.nvm"

[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

################################################################################
# pyenv - Python Version Manger
################################################################################
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"
eval "$(pyenv virtualenv-init -)"


################################################################################
# fzf
################################################################################
if command -v fzf >/dev/null 2>&1; then
    FZF_SHELL_CONFIG=~/.fzf.$(basename $SHELL)

    # source fzf
    [ -f "$FZF_SHELL_CONFIG" ] && . $FZF_SHELL_CONFIG

    # define how fzf looks
    export FZF_DEFAULT_OPTS='--layout=default --no-height'
    export FZF_CTRL_T_OPTS='--layout=default'
    export FZF_ALT_C_OPTS='--layout=default'

    if command -v fd >/dev/null 2>&1; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden'
        export FZF_CTRL_T_COMMAND="${FZF_DEFAULT_COMMAND}"
        export FZF_ALT_C_COMMAND='fd --type d --hidden'
    fi
fi

################################################################################
# linuxbrew
################################################################################
if [ "$(uname)" = "Linux" ]; then
    [ -x /home/linuxbrew/.linuxbrew/bin/brew ] &&
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    [ -f "$HOME/.local/share/../bin/env" ] &&
        . "$HOME/.local/share/../bin/env"
fi

