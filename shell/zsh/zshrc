#!/bin/env zsh

CURRENT_DIR=$( cd "$( dirname -- ${(%):-%x} )" && pwd )
ZSHRC="$CURRENT_DIR/.zshrc"

[ -L "$ZSHRC" ] && CURRENT_DIR=$( dirname "$( readlink $ZSHRC )" )

################################################################################
# Load Custom System Configuration
################################################################################
SHARED_CONFIG=$CURRENT_DIR/../shared/init
[ -f "$SHARED_CONFIG" ] && source $SHARED_CONFIG/init

################################################################################
# Load zsh aliases
################################################################################
ZSH_ALIAS="$CURRENT_DIR/alias.zsh"
[ -f "$ZSH_ALIAS" ] && source $ZSH_ALIAS

if command -v keychain > /dev/null 2>&1; then
    eval "$(keychain --eval --agents ssh --quiet)"
fi

################################################################################
# Antidote - Zsh plugin manager
################################################################################
ANTIDOTE_DIR="$HOME/.local/share/zsh/plugins/antidote"
ANTIDOTE="$ANTIDOTE_DIR/antidote.zsh"
ZSH_PLUGINS="$HOME/.config/zsh/plugins.txt"
ZSH_PLUGINS_STATIC="$HOME/.cache/zsh/plugins.zsh"

if [ ! -f "$ANTIDOTE" ] && command -v git >/dev/null 2>&1; then
  mkdir -p "${ANTIDOTE_DIR:h}"
  git clone --depth=1 https://github.com/mattmc3/antidote.git "$ANTIDOTE_DIR"
fi

if [ -f "$ANTIDOTE" ]; then
  source "$ANTIDOTE"

  mkdir -p "${ZSH_PLUGINS_STATIC:h}"

  if [ ! -f "$ZSH_PLUGINS_STATIC" ] ||
     [ "$ZSH_PLUGINS" -nt "$ZSH_PLUGINS_STATIC" ]; then
    antidote bundle < "$ZSH_PLUGINS" > "$ZSH_PLUGINS_STATIC"
  fi

  source "$ZSH_PLUGINS_STATIC"
fi

################################################################################
# starship prompt
################################################################################
if command -v starship > /dev/null 2>&1; then
    eval "$(starship init zsh)"
fi
